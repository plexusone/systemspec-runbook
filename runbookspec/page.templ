package runbookspec

// pageDocument is the whole HTML document: its head, style and body.
templ pageDocument(v pageView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			if v.Generator != "" {
				<meta name="generator" content={ v.Generator }/>
			}
			<title>{ v.Title }</title>
			@templ.Raw("<style>\n" + Style + "\n</style>")
		</head>
		<body>
			<main>
				@pageBody(v)
			</main>
			@templ.Raw("<script>\n" + Script + "\n</script>")
		</body>
	</html>
}

// pageBody is the runbook itself, for a host's own page.
templ pageBody(v pageView) {
	<h1>{ v.Title }</h1>
	@v.Summary
	if v.Usage != nil {
		<h2 id="how-to-use-it">How to Use It</h2>
		@v.Usage
	}
	if v.BeforeIntro != nil {
		<h2 id="before-you-start">Before You Start</h2>
		@v.BeforeIntro
		if len(v.Variables) > 0 {
			<table>
				<thead>
					<tr><th>Variable</th><th>Set with</th><th>What</th><th>Used by</th></tr>
				</thead>
				<tbody>
					for _, vr := range v.Variables {
						<tr>
							<td><code>{ vr.Name }</code></td>
							<td>@vr.Source</td>
							<td>@vr.What</td>
							<td>@links(vr.UsedBy)</td>
						</tr>
					}
				</tbody>
			</table>
		}
		for _, in := range v.Inputs {
			<section class="input" id={ in.Anchor }>
				<h3>{ in.Name }</h3>
				@in.Description
				if in.Env != "" {
					<p>
						<span class="label">Set:</span> <code>export { in.Env }=…</code>
						if in.Secret {
							, in the shell that runs; it is a secret, never shown or written down
						}
						.
					</p>
				}
				if in.Check != "" {
					<p>
						<span class="label">Checked with:</span> <code>{ in.Check }</code>
						if in.Contains != "" {
							, which must print <code>{ in.Contains }</code>
						}
						.
					</p>
				}
				if in.HowTo != nil {
					@in.HowTo
				}
				if len(in.UsedBy) > 0 {
					<p><span class="label">Used by:</span> @links(in.UsedBy){ "." }</p>
				}
			</section>
		}
	}
	<h2 id="summary">Summary</h2>
	<table>
		<thead>
			<tr><th>Phase</th><th>Steps</th><th>What it gives you</th></tr>
		</thead>
		<tbody>
			for _, ph := range v.Phases {
				<tr>
					<td><a href={ templ.SafeURL("#" + ph.Anchor) }>{ ph.Heading }</a></td>
					<td>{ len(ph.Steps) }</td>
					<td>@ph.Gives</td>
				</tr>
			}
		</tbody>
	</table>
	for _, ph := range v.Phases {
		<h2 id={ ph.Anchor }>{ ph.Heading }</h2>
		if ph.Summary != nil {
			@ph.Summary
		}
		for _, s := range ph.Steps {
			@step(s)
		}
	}
	if len(v.Troubleshoot) > 0 {
		<h2 id="troubleshooting">Troubleshooting</h2>
		<p>When a command fails, a run shows each fix whose pattern its output or error matches.</p>
		@fixes(v.Troubleshoot)
	}
	if len(v.Later) > 0 {
		<h2 id="later">Later</h2>
		<table>
			<thead>
				<tr><th>What</th><th>Needs</th></tr>
			</thead>
			<tbody>
				for _, l := range v.Later {
					<tr><td>{ l.What }</td><td>@l.Needs</td></tr>
				}
			</tbody>
		</table>
	}
}

// step is one step: its owner and dependencies, actions, notes, the
// credentials it creates, when it is done, and its checks.
templ step(s stepView) {
	<section class="step" id={ s.Anchor }>
		<h3>{ s.Heading }</h3>
		<div class="meta">
			<span class={ "badge", s.Owner }>{ s.Owner }</span>
			if s.Gate {
				<span class="badge">gate</span>
			}
			if len(s.After) > 0 {
				<span>
					after
					for i, a := range s.After {
						if i > 0 {
							,
						}
						<a href={ templ.SafeURL(a.Href) }>{ a.Text }</a>
					}
				</span>
			}
		</div>
		if s.Summary != nil {
			@s.Summary
		}
		if len(s.Needs) > 0 {
			<p><span class="label">Needs:</span> @links(s.Needs){ "." }</p>
		}
		if len(s.Actions) > 0 {
			<ol class="actions">
				for _, a := range s.Actions {
					<li>
						if a.Owner != "" {
							<span class={ "badge", a.Owner }>{ a.Owner }</span>
						}
						@a.Text
						if a.Link != nil {
							<p>See <a href={ templ.SafeURL(a.Link.Href) }>{ a.Link.Text }</a>@newTab(a.Link.Href){ "." }</p>
						}
						if a.Code != "" {
							<pre><code>{ a.Code }</code></pre>
						}
					</li>
				}
			</ol>
		}
		for _, n := range s.Notes {
			@n
		}
		if len(s.Credentials) > 0 {
			<p>
				<span class="label">Creates:</span>
				for i, c := range s.Credentials {
					if i > 0 {
						,
					}
					<code>{ c }</code>
				}
			</p>
		}
		<div><span class="label">Done when</span> @s.Done</div>
		if len(s.Checks) > 0 {
			<p>
				<span class="label">Checks</span>
				if s.VerifyCommand != "" {
					(<code>{ s.VerifyCommand }</code>)
				}
				:
			</p>
			<ul>
				for _, c := range s.Checks {
					<li>@c</li>
				}
			</ul>
		}
		if len(s.Troubleshoot) > 0 {
			<p><span class="label">Troubleshooting:</span></p>
			@fixes(s.Troubleshoot)
		}
	</section>
}

// fixes lists fixes: the pattern a failure's output matches, then what to
// do.
templ fixes(fs []fixView) {
	<ul class="fixes">
		for _, f := range fs {
			<li><code>{ f.Match }</code>: @f.Fix</li>
		}
	</ul>
}

// links is a comma-separated list of links within the page.
templ links(ls []linkView) {
	for i, l := range ls {
		if i > 0 {
			,
		}
		<a href={ templ.SafeURL(l.Href) }>{ l.Text }</a>
	}
}
